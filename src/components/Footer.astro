---
interface Props {
  metaLine: string;
  copyLine: string;
}

const { metaLine, copyLine } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">Dr Piet Malepa</p>
      <p class="footer-meta">{metaLine}</p>
    </div>
    <nav class="footer-links" aria-label="Site">
      <span class="footer-heading mono">Site</span>
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/#publications">Publications</a>
      <a href="/#studies">Studies</a>
    </nav>
    <nav class="footer-links" aria-label="Profile links">
      <span class="footer-heading mono">Profiles</span>
      <a href="https://za.linkedin.com/in/dr-piet-lesiba-malepa-phd-9296ab7b" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span>ORCID</span>
      <span>ResearchGate</span>
      <span>Google Scholar</span>
    </nav>
    <nav class="footer-links" aria-label="Contact">
      <span class="footer-heading mono">Contact</span>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <span>Pretoria, ZA</span>
    </nav>
    <nav class="footer-links" aria-label="Legal">
      <span class="footer-heading mono">Legal</span>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/cookie-policy">Cookie Policy</a>
      <a href="/terms-and-conditions">Terms and Conditions</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span class="mono">{copyLine}</span>
    <span class="mono">Wildlife Systems Lab · Pretoria</span>
  </div>
</footer>
