---
interface Props {
  metaLine: string;
  copyLine: string;
}

const { metaLine, copyLine } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">Dr Piet Malepa</p>
      <p class="footer-meta">{metaLine}</p>
      <p class="footer-copy">{copyLine}</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
</footer>
