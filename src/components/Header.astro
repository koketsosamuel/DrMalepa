---
export interface NavLink {
  href: string;
  label: string;
  active?: boolean;
}

export interface CTA {
  label: string;
  href: string;
}

interface Props {
  brandRole: string;
  navLinks: NavLink[];
  cta: CTA;
}

const { brandRole, navLinks, cta } = Astro.props;
---
<div class="meta-bar pad-x">
  <span class="mono">Wildlife Systems Lab · Pretoria · ZA</span>
  <span class="mono"><span class="live-dot" aria-hidden="true"></span>Field season · Active</span>
  <span class="mono">Vol. XII · May 2026</span>
</div>
<header class="top-nav">
  <div class="nav-inner pad-x">
    <a class="brand" href="/">
      <span class="brand-role mono">{brandRole}</span>
      <p class="brand-name">Dr Piet Malepa</p>
    </a>
    <details class="mobile-menu">
      <summary class="menu-pill">Menu</summary>
      <nav class="mobile-menu-panel" aria-label="Mobile">
        {navLinks.map((link) => (
          <a class={`nav-link${link.active ? ' active' : ''}`} href={link.href}>{link.label}</a>
        ))}
        <a class="btn btn-primary btn-small mobile-menu-cta" href={cta.href}>{cta.label}</a>
      </nav>
    </details>
    <nav class="nav-links" aria-label="Primary">
      {navLinks.map((link) => (
        <a class={`nav-link${link.active ? ' active' : ''}`} href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-small nav-cta" href={cta.href}>{cta.label}</a>
  </div>
</header>
