---
import Icon from './Icon.astro';

export interface NavLink {
  href: string;
  label: string;
  active?: boolean;
}

export interface CTA {
  label: string;
  href: string;
  arrow?: boolean;
}

interface Props {
  navLinks: NavLink[];
  cta: CTA;
}

const { navLinks, cta } = Astro.props;
---
<header class="top-nav">
  <div class="nav-inner pad-x">
    <a class="brand" href="/">
      <p class="brand-name">Dr Piet Malepa</p>
    </a>
    <details class="mobile-menu">
      <summary class="menu-pill">Menu</summary>
      <nav class="mobile-menu-panel" aria-label="Mobile">
        {navLinks.map((link) => (
          <a class={`nav-link${link.active ? ' active' : ''}`} href={link.href}>{link.label}</a>
        ))}
        <a class="btn btn-primary btn-small mobile-menu-cta" href={cta.href}>
          {cta.label}
          {cta.arrow && <Icon name="arrow-right" />}
        </a>
      </nav>
    </details>
    <nav class="nav-links" aria-label="Primary">
      {navLinks.map((link) => (
        <a class={`nav-link${link.active ? ' active' : ''}`} href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-small nav-cta" href={cta.href}>
      {cta.label}
      {cta.arrow && <Icon name="arrow-right" />}
    </a>
  </div>
</header>
