---
import Layout from '../layouts/Layout.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact', active: true },
];
const cta = { label: 'Email Dr Malepa', href: 'mailto:piet.malepa@gmail.com' };
---
<Layout
  title="Contact Dr Piet Malepa | Research Collaborations"
  description="Contact Dr Piet Lesiba Malepa for research collaborations, speaking invites, and conservation partnerships. Email piet.malepa@gmail.com. Based in Pretoria, South Africa."
  keywords="contact Piet Malepa, conservation collaboration South Africa, amphibian research partnership"
  image="/assets/images/optimized/dr-piet-malepa-office-right.jpg"
  navLinks={navLinks}
  cta={cta}
  footerMeta="Home | Research | About | Contact"
  footerCopy="© 2026 Contact Page"
>
  <main>
    <section class="section">
      <div class="container contact-grid">
        <div>
          <h1 class="display-title">Contact</h1>
          <p class="lead">
            For collaborations, speaking invites, and research partnerships, reach out directly by email.
          </p>
          <ul class="detail-list" style="margin-top: 28px;">
            <li>Email: <a class="inline-link" href="mailto:piet.malepa@gmail.com">piet.malepa@gmail.com</a></li>
            <li>Based in: Pretoria, South Africa</li>
            <li>Response: Within 2-4 business days</li>
          </ul>
          <div class="button-row">
            <a class="btn btn-primary" href="mailto:piet.malepa@gmail.com">Email Dr Malepa</a>
          </div>
        </div>
        <div class="detail-image">
          <img src="/assets/images/optimized/dr-piet-malepa-office-right.jpg" alt="Portrait of Dr Piet Malepa seated in his office" />
        </div>
      </div>
    </section>
  </main>
</Layout>
